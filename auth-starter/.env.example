# 复制为 .env 后按需修改：copy .env.example .env（Windows）/ cp .env.example .env（macOS / Linux）
# 所有配置均可省略，省略时使用下面的默认值。

# JWT 签名密钥。留空则首次启动自动生成，并保存到 data/secret.key。
# 生产环境务必设置为足够长的随机字符串，例如：
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 访问令牌有效期（分钟），默认 1440 分钟 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite 数据库文件路径（相对路径基于项目根目录）
DATABASE_PATH=data/app.db

# 已显式设置 DATABASE_PATH 时，仅修改 DATA_DIR 不会移动数据库。
# 删除或注释 DATABASE_PATH 后，数据库默认位于 DATA_DIR/app.db。
# 数据目录（存放 secret.key），一般不用改。
DATA_DIR=data

# 允许跨域的前端来源，多个用英文逗号分隔。
# 默认放行常见的本地开发地址（VS Code Live Server 5500/5501、Vite 5173、React 3000）。
# 仅前端与后端跨域部署或用 Live Server 额外调试时需要修改。
# 通过 start.bat 同时提供页面和 API 时，改服务端口也无需修改 CORS。
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# 每个 IP 每分钟允许的登录/注册请求数，0 表示关闭限流
RATE_LIMIT_PER_MINUTE=20
